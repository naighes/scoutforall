# The bindings generated by UniFFI call the core through JNA, which finds the
# native functions, the structures and the callbacks by their names and their
# fields, with reflection: R8 must rename or remove none of them.
-keep class com.sun.jna.** { *; }
-keep class * implements com.sun.jna.** { *; }
-keepclassmembers class * extends com.sun.jna.** { public *; }
-keep class io.github.naighes.scout4all.core.** { *; }

# JNA refers to the desktop (AWT), absent on Android and never called there.
-dontwarn java.awt.**

# The stack of a crash keeps its lines (the crash report, the console of
# Play with the mapping file).
-keepattributes SourceFile,LineNumberTable
-renamesourcefileattribute SourceFile
