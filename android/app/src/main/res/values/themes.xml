<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, as the site: Compose draws the rest (Theme.kt). -->
    <style name="Theme.Scout4All" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Theme.Scout4All.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Scout4All</item>
    </style>
</resources>
