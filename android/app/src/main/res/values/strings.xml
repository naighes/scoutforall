    <!-- the tutorial -->
    <string name="tutorial">Tutorial</string>
    <string name="tutorial_detail">How to scout a match, with the example team</string>
    <string name="tutorial_skip">Skip</string>
    <string name="tutorial_next">Next</string>
    <string name="tutorial_progress">%1$d of %2$d</string>
    <string name="tutorial_welcome">Let me show you how to scout a match, with the example team: Italy\'s women\'s national team. It takes a couple of minutes.</string>
    <string name="tutorial_team">This is the example team: touch it.</string>
    <string name="tutorial_matches">Here are the players. The matches are in the other tab: touch it.</string>
    <string name="tutorial_new_match">Touch + for a new match.</string>
    <string name="tutorial_match_fields">Opponent, date, home or away, substitutions: I filled them in.</string>
    <string name="tutorial_save_match">Touch Save.</string>
    <string name="tutorial_lineup">The lineup of the first set is ready: the setter in 6 (S6), we receive; Spirito is the libero, Fersino the second libero. Touching a position changes its player.</string>
    <string name="tutorial_start_set">Touch Start the set.</string>
    <string name="tutorial_score">The score, the phase and the rotation: side-out, S6 (the setter in 6). They serve.</string>
    <string name="tutorial_reception">Nervini receives: touch her.</string>
    <string name="tutorial_reception_eval">A perfect reception: touch #.</string>
    <string name="tutorial_attack">The setter sets her and she attacks: touch her again.</string>
    <string name="tutorial_attack_event">Touch Attack.</string>
    <string name="tutorial_attack_point">Her point: touch #.</string>
    <string name="tutorial_side_out">Side-out: 1–0. We rotate to S5 and Fahr serves.</string>
    <string name="tutorial_serve">The serve is ready to rate: a negative one, touch −.</string>
    <string name="tutorial_block">They attack and Danesi blocks: touch her.</string>
    <string name="tutorial_block_event">Touch Block.</string>
    <string name="tutorial_block_eval">The block touches it, but the ball stays on their side: touch −.</string>
    <string name="tutorial_dig">They attack again, Fahr digs: touch her.</string>
    <string name="tutorial_dig_event">Touch Defense.</string>
    <string name="tutorial_dig_eval">A good dig: touch +.</string>
    <string name="tutorial_opposite">Egonu attacks: touch her.</string>
    <string name="tutorial_attack_dug">They dig it: touch −.</string>
    <string name="tutorial_their_freeball">They send it back easy, a freeball: touch Their free.</string>
    <string name="tutorial_opposite_again">Egonu attacks again: touch her.</string>
    <string name="tutorial_their_error">Their attack goes out: touch Their error. 2–0.</string>
    <string name="tutorial_lineup_menu">Now a double substitution. The changes of the lineup are in the half moon: touch it.</string>
    <string name="tutorial_substitution">Touch Sub.</string>
    <string name="tutorial_out_egonu">Egonu goes out: touch her.</string>
    <string name="tutorial_in_cambi">Cambi, the second setter, comes in: touch her.</string>
    <string name="tutorial_lineup_again">The other one: the half moon again.</string>
    <string name="tutorial_out_orro">Orro goes out: touch her.</string>
    <string name="tutorial_in_antropova">Antropova, the second opposite, comes in: touch her.</string>
    <string name="tutorial_setter_menu">Now Cambi sets: the half moon again.</string>
    <string name="tutorial_setter">Touch Setter.</string>
    <string name="tutorial_setter_cambi">Touch Cambi: the rotation follows her.</string>
    <string name="tutorial_libero_menu">Last, the other libero: the half moon.</string>
    <string name="tutorial_libero">Touch Libero: Fersino takes the place of Spirito.</string>
    <string name="tutorial_stats">The statistics of the set and of the match: swipe up from here.</string>
    <string name="tutorial_done">That\'s all. The match stays with the example team: go on scouting it, or make your own team. Undo, at the bottom left, takes back the last touch. The tutorial is in the settings, to watch it again.</string>
    <string name="tutorial_finish">Finish</string>
</resources>
