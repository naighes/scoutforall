<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later animate the icon of the splash. -->
    <style name="Theme.Scout4All.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Scout4All</item>
    </style>
</resources>
