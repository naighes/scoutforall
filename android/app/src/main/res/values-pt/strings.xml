    <string name="tutorial_welcome">Vou mostrar como fazer o scout de uma partida, com o time de exemplo: a seleção feminina da Itália. Leva uns dois minutos.</string>
    <string name="tutorial_team">Este é o time de exemplo: toque no nome dele.</string>
    <string name="tutorial_matches">Aqui estão os jogadores. As partidas estão na outra aba: toque na aba.</string>
    <string name="tutorial_new_match">Toque em + para uma nova partida.</string>
    <string name="tutorial_match_fields">Adversário, data, casa ou fora, substituições: eu já preenchi.</string>
    <string name="tutorial_match_next">Toque em Continuar: depois os jogadores na súmula.</string>
    <string name="tutorial_roster">Todo o time está na súmula, até 14: um toque tira ou recoloca um jogador.</string>
    <string name="tutorial_save_match">Toque em Salvar.</string>
    <string name="tutorial_lineup">A escalação do primeiro set está pronta: levantador na 6 (P6), nós na recepção; Spirito é o líbero, Fersino o segundo líbero. Tocando uma posição, troca-se o jogador.</string>
    <string name="tutorial_start_set">Toque em Iniciar o set.</string>
    <string name="tutorial_score">O placar, a fase e o rodízio: side-out, P6 (levantador na 6). Eles sacam.</string>
    <string name="tutorial_reception">Nervini recebe: toque no seu nome.</string>
    <string name="tutorial_reception_eval">Recepção perfeita: toque em #.</string>
    <string name="tutorial_attack">O levantamento é para Nervini, que ataca: toque no seu nome de novo.</string>
    <string name="tutorial_attack_point">Agora só pode atacar, então a avaliação vem logo. Ponto de Nervini: toque em #.</string>
    <string name="tutorial_side_out">Side-out: 1–0. Rodamos para P5 e Fahr saca.</string>
    <string name="tutorial_serve_cell">Onde foi o saque? Opcional: toque em 1D.</string>
    <string name="tutorial_serve_conflict">Depois 6A, ao lado: duas células de zonas diferentes ficam na linha entre elas, a zona de conflito 6/1.</string>
    <string name="tutorial_serve">O saque já está pronto para avaliar: negativo, toque em −.</string>
    <string name="tutorial_block">Eles atacam e Danesi bloqueia: toque no seu nome.</string>
    <string name="tutorial_block_event">Toque em Bloqueio.</string>
    <string name="tutorial_block_eval">O bloqueio toca, mas a bola fica do lado deles: toque em −.</string>
    <string name="tutorial_dig">Eles atacam de novo, Fahr defende: toque no seu nome.</string>
    <string name="tutorial_dig_event">Toque em Defesa.</string>
    <string name="tutorial_dig_eval">Uma boa defesa: toque em +.</string>
    <string name="tutorial_opposite">Egonu ataca: toque no seu nome.</string>
    <string name="tutorial_attack_kept">Eles defendem, mas não conseguem atacar: a bola volta para nós, toque em +.</string>
    <string name="tutorial_attack_dug">Eles defendem e atacam: toque em −.</string>
    <string name="tutorial_their_freeball">Eles devolvem fácil, uma bola de graça: toque em Bola de graça deles.</string>
    <string name="tutorial_opposite_again">Egonu ataca de novo: toque no seu nome.</string>
    <string name="tutorial_attack_event">Toque em Ataque.</string>
    <string name="tutorial_their_error">O ataque deles sai: toque em Erro deles. 2–0.</string>
    <string name="tutorial_lineup_menu">Agora uma dupla substituição. As mudanças de escalação estão na meia-lua: toque na meia-lua.</string>
