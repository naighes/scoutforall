    <string name="tutorial_progress">%1$d de %2$d</string>
    <string name="tutorial_welcome">Vou mostrar como fazer o scout de uma partida, com o time de exemplo: a seleção feminina da Itália. Leva uns dois minutos.</string>
    <string name="tutorial_team">Este é o time de exemplo: toque no nome dele.</string>
    <string name="tutorial_matches">Aqui estão as jogadoras. As partidas estão na outra aba: toque na aba.</string>
    <string name="tutorial_new_match">Toque em + para uma nova partida.</string>
    <string name="tutorial_match_fields">Adversário, data, casa ou fora, substituições: eu já preenchi.</string>
    <string name="tutorial_match_next">Toque em Continuar: depois as jogadoras na súmula.</string>
    <string name="tutorial_roster">Todo o time está na súmula, até 14: um toque tira ou recoloca uma jogadora.</string>
    <string name="tutorial_save_match">Toque em Salvar.</string>
    <string name="tutorial_lineup">A escalação do primeiro set está pronta: levantadora na 6 (P6), nós na recepção; Spirito é a líbero, Fersino a segunda líbero. Tocando uma posição, troca-se a jogadora.</string>
    <string name="tutorial_start_set">Toque em Iniciar o set.</string>
    <string name="tutorial_score">O placar, a fase e o rodízio: side-out, P6 (levantadora na 6). Elas sacam.</string>
    <string name="tutorial_reception">Nervini recebe: toque no nome dela.</string>
    <string name="tutorial_reception_eval">Recepção perfeita: toque em #.</string>
    <string name="tutorial_attack">O levantamento é para ela, que ataca: toque no nome dela de novo.</string>
    <string name="tutorial_attack_event">Toque em Ataque.</string>
    <string name="tutorial_attack_point">Ponto dela: toque em #.</string>
    <string name="tutorial_side_out">Side-out: 1–0. Rodamos para P5 e Fahr saca.</string>
    <string name="tutorial_serve">O saque já está pronto para avaliar: negativo, toque em −.</string>
    <string name="tutorial_block">Elas atacam e Danesi bloqueia: toque no nome dela.</string>
    <string name="tutorial_block_event">Toque em Bloqueio.</string>
    <string name="tutorial_block_eval">O bloqueio toca, mas a bola fica do lado delas: toque em −.</string>
    <string name="tutorial_dig">Elas atacam de novo, Fahr defende: toque no nome dela.</string>
    <string name="tutorial_dig_event">Toque em Defesa.</string>
    <string name="tutorial_dig_eval">Uma boa defesa: toque em +.</string>
    <string name="tutorial_opposite">Egonu ataca: toque no nome dela.</string>
    <string name="tutorial_attack_dug">Elas defendem: toque em −.</string>
    <string name="tutorial_their_freeball">Elas devolvem fácil, uma bola de graça: toque em Bola de graça deles.</string>
    <string name="tutorial_opposite_again">Egonu ataca de novo: toque no nome dela.</string>
    <string name="tutorial_their_error">O ataque delas sai: toque em Erro deles. 2–0.</string>
    <string name="tutorial_lineup_menu">Agora uma dupla substituição. As mudanças de escalação estão na meia-lua: toque na meia-lua.</string>
    <string name="tutorial_substitution">Toque em Subst.</string>
    <string name="tutorial_out_egonu">Sai Egonu: toque no nome dela.</string>
    <string name="tutorial_in_cambi">Entra Cambi, a segunda levantadora: toque no nome dela.</string>
    <string name="tutorial_lineup_again">A outra: a meia-lua de novo.</string>
    <string name="tutorial_out_orro">Sai Orro: toque no nome dela.</string>
    <string name="tutorial_in_antropova">Entra Antropova, a segunda oposta: toque no nome dela.</string>
    <string name="tutorial_setter_menu">Agora Cambi levanta: a meia-lua de novo.</string>
    <string name="tutorial_setter">Toque em Levant.</string>
    <string name="tutorial_setter_cambi">Toque em Cambi: o rodízio segue ela.</string>
    <string name="tutorial_libero_menu">Por último, a outra líbero: a meia-lua.</string>
    <string name="tutorial_libero">Toque em Líbero: Fersino toma o lugar de Spirito.</string>
    <string name="tutorial_stats">As estatísticas do set e da partida: toque aqui ou deslize para cima daqui.</string>
    <string name="tutorial_done">É isso. A partida fica no time de exemplo: continue o scout ou crie o seu time. Desfazer, embaixo à esquerda, tira o último toque. O tutorial está nas configurações, para ver de novo.</string>
