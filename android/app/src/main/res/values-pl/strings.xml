    <string name="tutorial_welcome">Pokażę ci, jak prowadzić scouting meczu, z przykładową drużyną: reprezentacją Włoch kobiet. To zajmie kilka minut.</string>
    <string name="tutorial_team">To jest przykładowa drużyna: dotknij jej nazwy.</string>
    <string name="tutorial_matches">Tu są zawodnicy. Mecze są w drugiej karcie: dotknij karty.</string>
    <string name="tutorial_new_match">Dotknij +, aby dodać nowy mecz.</string>
    <string name="tutorial_match_fields">Przeciwnik, data, u siebie czy na wyjeździe, zmiany: są już wypełnione.</string>
    <string name="tutorial_match_next">Dotknij Kontynuuj: potem zawodnicy w protokole.</string>
    <string name="tutorial_roster">Cała drużyna jest w protokole, do 14: dotknięcie usuwa zawodnika lub go przywraca.</string>
    <string name="tutorial_save_match">Dotknij Zapisz.</string>
    <string name="tutorial_lineup">Skład pierwszego seta jest gotowy: rozgrywający na 6 (R6), my przyjmujemy; Spirito jest libero, Fersino drugim libero. Dotknięcie pozycji zmienia na niej zawodnika.</string>
    <string name="tutorial_start_set">Dotknij Rozpocznij seta.</string>
    <string name="tutorial_score">Wynik, faza i ustawienie: side-out, R6 (rozgrywający na 6). Zagrywa rywal.</string>
    <string name="tutorial_reception">Przyjmuje Nervini: dotknij nazwiska.</string>
    <string name="tutorial_reception_eval">Idealne przyjęcie: dotknij #.</string>
    <string name="tutorial_attack">Wystawa do Nervini, atak: znowu dotknij nazwiska.</string>
    <string name="tutorial_attack_point">Teraz możliwy jest tylko atak, więc ocena pojawia się od razu. Punkt: dotknij #.</string>
    <string name="tutorial_side_out">Side-out: 1–0. Przechodzimy na R5, zagrywa Fahr.</string>
    <string name="tutorial_serve_cell">Gdzie poszła zagrywka? Opcjonalnie: dotknij 1D.</string>
    <string name="tutorial_serve_conflict">Potem 6A obok: dwie komórki dwóch stref leżą na linii między nimi, strefa konfliktu 6/1.</string>
    <string name="tutorial_serve">Zagrywka czeka na ocenę: negatywna, dotknij −.</string>
    <string name="tutorial_block">Rywal atakuje, blokuje Danesi: dotknij nazwiska.</string>
    <string name="tutorial_block_event">Dotknij Blok.</string>
    <string name="tutorial_block_eval">Blok dotyka piłki, ale zostaje po ich stronie: dotknij −.</string>
    <string name="tutorial_dig">Rywal znowu atakuje, broni Fahr: dotknij nazwiska.</string>
    <string name="tutorial_dig_event">Dotknij Obrona.</string>
    <string name="tutorial_dig_eval">Dobra obrona: dotknij +.</string>
    <string name="tutorial_opposite">Atakuje Egonu: dotknij nazwiska.</string>
    <string name="tutorial_attack_kept">Rywal broni, ale nie może zaatakować: piłka wraca do nas, dotknij +.</string>
    <string name="tutorial_attack_dug">Rywal broni i atakuje: dotknij −.</string>
    <string name="tutorial_their_freeball">Odbijają łatwo, wolna piłka: dotknij Wolna rywala.</string>
    <string name="tutorial_opposite_again">Znowu atakuje Egonu: dotknij nazwiska.</string>
    <string name="tutorial_attack_event">Dotknij Atak.</string>
    <string name="tutorial_their_error">Ich atak w aut: dotknij Błąd rywala. 2–0.</string>
    <string name="tutorial_lineup_menu">Teraz podwójna zmiana. Zmiany składu są w półksiężycu: dotknij półksiężyca.</string>
    <string name="tutorial_substitution">Dotknij Zmiana.</string>
    <string name="tutorial_out_egonu">Schodzi Egonu: dotknij nazwiska.</string>
    <string name="tutorial_in_cambi">Wchodzi Cambi, drugi rozgrywający: dotknij nazwiska.</string>
    <string name="tutorial_lineup_again">Druga: znowu półksiężyc.</string>
    <string name="tutorial_out_orro">Schodzi Orro: dotknij nazwiska.</string>
    <string name="tutorial_in_antropova">Wchodzi Antropova, drugi atakujący: dotknij nazwiska.</string>
    <string name="tutorial_setter_menu">Teraz rozgrywa Cambi: znowu półksiężyc.</string>
    <string name="tutorial_setter">Dotknij Rozgr.</string>
    <string name="tutorial_setter_cambi">Dotknij Cambi: ustawienie idzie za nowym rozgrywającym.</string>
    <string name="tutorial_libero_menu">Na koniec drugi libero: półksiężyc.</string>
    <string name="tutorial_libero">Dotknij Libero: Fersino zastępuje Spirito.</string>
    <string name="tutorial_stats">Statystyki seta i meczu: dotknij tutaj albo przesuń stąd w górę.</string>
    <string name="tutorial_done">To wszystko. Mecz zostaje w przykładowej drużynie: kontynuuj scouting albo utwórz własną drużynę. Cofnij, w lewym dolnym rogu, usuwa ostatnie dotknięcie. Samouczek jest w ustawieniach, aby obejrzeć go ponownie.</string>
