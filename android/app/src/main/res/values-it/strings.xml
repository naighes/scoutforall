    <!-- the tutorial -->
    <string name="tutorial">Tutorial</string>
    <string name="tutorial_detail">Come si fa lo scouting di una partita, con la squadra di esempio</string>
    <string name="tutorial_skip">Salta</string>
    <string name="tutorial_next">Avanti</string>
    <string name="tutorial_progress">%1$d di %2$d</string>
    <string name="tutorial_welcome">Ti mostro come si fa lo scouting di una partita, con la squadra di esempio: la nazionale italiana femminile. Ci vogliono un paio di minuti.</string>
    <string name="tutorial_team">Questa è la squadra di esempio: tocca il suo nome.</string>
    <string name="tutorial_matches">Qui ci sono le giocatrici. Le partite sono nell\'altra scheda: tocca la scheda.</string>
    <string name="tutorial_new_match">Tocca + per una nuova partita.</string>
    <string name="tutorial_match_fields">Avversario, data, casa o trasferta, cambi: li ho già scritti io.</string>
    <string name="tutorial_save_match">Tocca Salva.</string>
    <string name="tutorial_lineup">La formazione del primo set è pronta: palleggiatrice in 6 (P6), noi in ricezione; Spirito è il libero, Fersino il secondo libero. Toccando una posizione se ne cambia la giocatrice.</string>
    <string name="tutorial_start_set">Tocca Inizia il set.</string>
    <string name="tutorial_score">Il punteggio, la fase e la rotazione: side-out, P6 (palleggiatrice in 6). Battono loro.</string>
    <string name="tutorial_reception">Riceve Nervini: tocca il suo nome.</string>
    <string name="tutorial_reception_eval">Ricezione perfetta: tocca #.</string>
    <string name="tutorial_attack">L\'alzata è per lei, che attacca: tocca di nuovo il suo nome.</string>
    <string name="tutorial_attack_event">Tocca Attacco.</string>
    <string name="tutorial_attack_point">Punto suo: tocca #.</string>
    <string name="tutorial_side_out">Side-out: 1–0. Si ruota in P5 e batte Fahr.</string>
    <string name="tutorial_serve">La battuta è già pronta da valutare: negativa, tocca −.</string>
    <string name="tutorial_block">Attaccano loro e mura Danesi: tocca il suo nome.</string>
    <string name="tutorial_block_event">Tocca Muro.</string>
    <string name="tutorial_block_eval">Il muro la tocca, ma la palla resta nel loro campo: tocca −.</string>
    <string name="tutorial_dig">Attaccano di nuovo, difende Fahr: tocca il suo nome.</string>
    <string name="tutorial_dig_event">Tocca Difesa.</string>
    <string name="tutorial_dig_eval">Una buona difesa: tocca +.</string>
    <string name="tutorial_opposite">Attacca Egonu: tocca il suo nome.</string>
    <string name="tutorial_attack_dug">Loro la difendono: tocca −.</string>
    <string name="tutorial_their_freeball">La rimandano facile, una freeball: tocca Free loro.</string>
    <string name="tutorial_opposite_again">Attacca ancora Egonu: tocca il suo nome.</string>
    <string name="tutorial_their_error">Il loro attacco finisce fuori: tocca Errore loro. 2–0.</string>
    <string name="tutorial_lineup_menu">Ora un doppio cambio. I cambi di formazione sono nella mezzaluna: tocca la mezzaluna.</string>
    <string name="tutorial_substitution">Tocca Sostituzione.</string>
    <string name="tutorial_out_egonu">Esce Egonu: tocca il suo nome.</string>
    <string name="tutorial_in_cambi">Entra Cambi, la seconda palleggiatrice: tocca il suo nome.</string>
    <string name="tutorial_lineup_again">L\'altro: di nuovo la mezzaluna.</string>
    <string name="tutorial_out_orro">Esce Orro: tocca il suo nome.</string>
    <string name="tutorial_in_antropova">Entra Antropova, il secondo opposto: tocca il suo nome.</string>
    <string name="tutorial_setter_menu">Ora alza Cambi: di nuovo la mezzaluna.</string>
    <string name="tutorial_setter">Tocca Palleggiatore.</string>
    <string name="tutorial_setter_cambi">Tocca Cambi: la rotazione segue lei.</string>
    <string name="tutorial_libero_menu">Per ultimo, l\'altro libero: la mezzaluna.</string>
    <string name="tutorial_libero">Tocca Libero: Fersino prende il posto di Spirito.</string>
    <string name="tutorial_stats">Le statistiche del set e della partita: tocca qui, oppure scorri verso l\'alto da qui.</string>
    <string name="tutorial_done">È tutto. La partita resta nella squadra di esempio: continua a fare lo scouting o crea la tua squadra. Annulla, in basso a sinistra, toglie l\'ultimo tocco. Il tutorial è nelle impostazioni, per rivederlo.</string>
    <string name="tutorial_finish">Fine</string>
</resources>
