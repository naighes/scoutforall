---

import { languages, language, homeUrl, content } from '../lib/languages.js';
const lang = Astro.params.lang || 'en';
import '../assets/css/global.css'
import "../assets/css/base.css"
import "../assets/css/typography.css"
import "../assets/css/layout.css"
import "../assets/css/buttons.css"

import { Font } from 'astro:assets';

import Image from "astro/components/Image.astro"
import bg_image from "../assets/theme-images/hero-image.jpg"

const global_settings = content(lang, 'global_settings');

import { latestRelease } from '../lib/release.js';
const release = await latestRelease();

import FooterMain from "../components/FooterMain.astro"
import HeaderMain from "../components/HeaderMain.astro"

// url: the address of a page other than the home page, in one language only
const { title, description, url } = Astro.props

---

<html lang={ language(lang).hreflang }>

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{ title ?? global_settings.title }</title>

    <link rel="icon" type="image/svg+xml" href="/scoutforall/favicon.svg" />
    <link rel="apple-touch-icon" href="/scoutforall/apple-touch-icon.png" />
    <link rel="manifest" href="/scoutforall/manifest.json" />

    <meta name="description" content={ description ?? global_settings.description } />
    <meta name="theme-color" content={ global_settings.theme_color } />

    <meta property="og:title" content={ title ?? global_settings.title } />
    <meta property="og:description" content={ description ?? global_settings.description } />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ url ?? homeUrl(lang) } />
    <meta property="og:image" content="https://naighes.github.io/scoutforall/1200x630.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={ language(lang).locale } />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ title ?? global_settings.title } />
    <meta name="twitter:description" content={ description ?? global_settings.description } />
    <meta name="twitter:image" content="https://naighes.github.io/scoutforall/1200x630.jpg" />
    <meta name="google-site-verification" content="bKdeAtfwmVXhzaUofyWon1aIpsOL0egnqXIeN8dfS7k" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-inter-display" preload />

    {!url && languages.map(l =>
      <link
        rel="alternate"
        hreflang={ l.hreflang }
        href={ homeUrl(l.code) }
      />
    )}
    {!url &&
      <link
        rel="alternate"
        hreflang="x-default"
        href="https://naighes.github.io/scoutforall/"
      />
    }
    <link
      rel="canonical"
      href={ url ?? homeUrl(lang) }
    />
    <link rel="sitemap" href="/scoutforall/sitemap-index.xml" />

    <script data-goatcounter="https://scout4all.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

    <script type="application/ld+json" is:inline set:html={
        JSON.stringify({
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "scout4all",
          "applicationCategory": "SportsApplication",
          "operatingSystem": "macOS, Windows, Linux",
          "softwareVersion": release?.version,
          "url": "https://naighes.github.io/scoutforall/",
          "inLanguage": language(lang).hreflang,
          "description": description ?? global_settings.description,
          "image": "https://naighes.github.io/scoutforall/1200x630.jpg",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "creator": {
            "@type": "Person",
            "name": "Nicola Baldi"
          },
          "publisher": {
            "@type": "Organization",
            "name": "scout4all project",
            "url": "https://naighes.github.io/scoutforall/"
          }
        })
      } />
    <!-- the home page is english: move to the language picked in the
         selector, or else to the one of the browser; inline, so that it
         runs before the page renders -->
    <script is:inline define:vars={{ codes: languages.map(l => l.code).filter(c => c !== 'en') }}>
      (function () {
        var picked = null;
        try {
          picked = localStorage.getItem('scout4all-language');
        } catch (e) {}
        var browser = (navigator.language || navigator.userLanguage || '').slice(0, 2);
        var lang = picked || browser;
        if (location.pathname === '/scoutforall/' && !location.search && !location.hash && codes.indexOf(lang) !== -1) {
          window.location.replace('/scoutforall/' + lang + '/');
        }
      })();
    </script>
  </head>

  <body id="top">

    <!-- Skip link -->
    <a class="fixed -top-20 focus-visible:top-0 p-3 bg-black/90 transition-all duration-300" href="#main">{ global_settings.labels.skip_to_content }</a>

    <!-- bg image -->
    <Image src={ bg_image } alt="" format="avif" height={1080} width={1920} class="absolute min-h-svh object-cover inset-0 bottom-auto -z-1 w-full h-auto opacity-20 mask-b-from-50%" loading="eager" />

    <!-- Header -->
    <HeaderMain settings={ global_settings } />

    <!-- Main slot -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <FooterMain settings={ global_settings } />

  </body>
</html>
