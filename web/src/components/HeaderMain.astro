---

import Logo from '../assets/theme-images/logo.svg'
import { languages } from '../lib/languages.js'

const currentLang = Astro.params.lang || 'en';
const { settings } = Astro.props

---

<header class="sticky top-0 z-50 border-b border-white/5 bg-bs-surface-0/75 backdrop-blur-md supports-[backdrop-filter]:bg-bs-surface-0/60">

  <div class="bs-container h-16 flex justify-between items-center gap-4">

    <!-- Logo -->
    <a class="flex items-center gap-3 group" href={`/scoutforall/${currentLang}/`} aria-label={ settings.title + ' - Home' }>
      <Logo class="h-8 w-8 group-hover:-rotate-180 transition-transform ease-bs-spring duration-1000" height="32" width="32" />
      <span class="text-xl font-bold text-white leading-none">scout4all</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      { settings.nav.map( item =>
        <a class="px-4 py-2 rounded-md text-bs-foreground-dark hover:text-white hover:bg-white/5 transition-colors" href={`/scoutforall/${currentLang}/${item.link}`}>
          { item.title }
        </a>
      )}
    </nav>

    <!-- GitHub link + Language selector -->
    <div class="flex items-center gap-2">
      <a
        href={settings.github_url}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-md hover:bg-white/5 transition-colors"
        aria-label="GitHub"
      >
        <img src="/scoutforall/content-images/github-mark-white.svg" class="h-5 w-5 opacity-80" alt="" height="20" width="20" />
      </a>

      <select
        class="bg-bs-surface-1 border border-white/10 text-sm text-bs-foreground-light pl-2 pr-1 py-1.5 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-bs-accent/70"
        aria-label={ settings.labels.language }
        onchange="try { localStorage.setItem('scout4all-language', this.selectedOptions[0].dataset.lang) } catch (e) {} window.location.href = this.value"
      >
        {languages.map(lang =>
          <option value={`/scoutforall/${lang.code}/`} data-lang={lang.code} lang={lang.hreflang} selected={lang.code === currentLang}>{lang.label}</option>
        )}
      </select>
    </div>
  </div>

</header>
