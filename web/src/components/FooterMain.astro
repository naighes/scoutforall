---

import Logo from '../assets/theme-images/logo.svg'

const currentLang = Astro.params.lang || 'en'
const { settings } = Astro.props
const currentYear = new Date().getFullYear()
const copyright =
  currentYear === 2025 ? '2025' : `2025-${currentYear}`

---

<footer class="mt-32 border-t border-white/5 bg-bs-surface-1" id="contact">

  <div class="bs-container py-12 flex flex-col md:flex-row gap-8 md:items-center justify-between text-sm text-bs-foreground-dark">

    <!-- Logo -->
    <a class="flex items-center gap-3 group w-max" href="#top" aria-label={ settings.labels.back_to_top }>
      <Logo class="h-7 w-7 group-hover:-rotate-180 transition-transform ease-bs-spring duration-1000" height="28" width="28" />
      <span class="text-lg font-bold text-white leading-none">scout4all</span>
    </a>

    <!-- Links -->
    <nav class="flex flex-wrap gap-x-6 gap-y-2 [&_a]:hover:text-white [&_a]:transition-colors">
      { settings.nav.map( item =>
        <a href={ `/scoutforall/${currentLang}/${item.link}` }>{ item.title }</a>
      )}
      <a href={ settings.github_url }>GitHub</a>
      <a href="https://github.com/naighes/scoutforall/blob/master/LICENSE">{ settings.labels.license }</a>
      <a href="/scoutforall/privacy/">{ settings.labels.privacy }</a>
    </nav>

  </div>

  <!-- Colophon -->
  <div class="bs-container pb-10 flex flex-col sm:flex-row gap-2 sm:gap-4 justify-between text-xs text-white/50">
    <span>© {copyright} scout4all · AGPL-3.0</span>
    <span>{ settings.labels.made_with } <a class="hover:text-white" href="https://github.com/naighes">n@ighes</a></span>
  </div>

</footer>
