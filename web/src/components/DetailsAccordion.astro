---

import Arrow from '../assets/theme-images/icon-arrow.svg'

const { question, answer } = Astro.props

---

<details name="faq"
class="group border-b border-white/10 w-full">

  <!-- Summary -->
  <summary class="flex gap-3 justify-between items-center py-5 cursor-pointer">

    <!-- Title -->
    <span class="select-none font-medium text-lg text-white group-hover:text-bs-accent transition-colors" set:html={ question } />

    <!-- Icon -->
    <span>
      <Arrow class="opacity-60 h-4 w-4 transition -rotate-90 group-open:rotate-90 ease-bs-bounce duration-1000" height="16" width="25" />
    </span>
  </summary>

  <!-- Content -->
  <div class="anim-wrapper max-w-none">

    <div set:html={ answer } class="pb-6 pr-8 bs-body-text text-bs-foreground-dark [&_a]:text-bs-accent [&_a]:underline [&_a]:underline-offset-2" />

  </div>

</details>


<style>

summary::-webkit-details-marker {
  display: none
}

details {

  @media (prefers-reduced-motion: no-preference) {
    interpolate-size: allow-keywords;
  }

  &::details-content {
    block-size: 0;
    opacity: 0;
    overflow-y: clip;
    transition: content-visibility 1s allow-discrete, opacity 1s, block-size 1s var(--ease-bs-bounce);
  }

  &[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
}

</style>
