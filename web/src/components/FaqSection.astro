---

import DetailsAccordion from "./DetailsAccordion.astro"

const { title, faq } = Astro.props

---

<section class="bs-container bs-mt-lg grid lg:grid-cols-12 gap-8" id="faq">

  <!-- Title -->
  { title && <h2 class="bs-h2 lg:col-span-4" set:html={ title } />}

  <!-- FAQ -->
  <div class="lg:col-span-8 border-t border-white/10">

    <!-- Item -->
    { faq.map( item =>

      <DetailsAccordion question={item.question} answer={item.answer} />

    )}

  </div>

</section>
